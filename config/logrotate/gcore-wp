# WordPress plugin logs (gCore ecosystem)
# Managed by GSD - install with: sudo cp /opt/GSD/config/logrotate/gcore-wp /etc/logrotate.d/
/var/www/*/wp-content/logs/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data www-data
    dateext
    dateformat -%Y%m%d
    sharedscripts
}
