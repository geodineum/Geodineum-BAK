# gCore bootstrap and diagnostics logs
# Managed by GSD - install with: sudo cp /opt/GSD/config/logrotate/gcore /etc/logrotate.d/
/var/log/gcore/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data www-data
    dateext
    dateformat -%Y%m%d
}
